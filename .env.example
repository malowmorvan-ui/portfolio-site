# Copie ce fichier en .env.local pour le développement local
# (cp .env.example .env.local), et renseigne les mêmes variables
# dans Railway → ton service → Variables pour la production.

# --- Cloudflare R2 ---
# Trouvés dans Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Nom du bucket créé dans Cloudflare R2
R2_BUCKET_NAME=
# URL publique du bucket : soit le sous-domaine r2.dev fourni par Cloudflare
# (Bucket > Settings > Public access), soit un domaine personnalisé connecté
# au bucket. Sans slash final. Ex: https://pub-xxxx.r2.dev ou https://media.tonsite.com
R2_PUBLIC_URL=

# --- Administration du site (/admin) ---
# Mot de passe pour te connecter à l'interface d'administration.
ADMIN_PASSWORD=
# Chaîne aléatoire longue utilisée pour signer la session de connexion.
# Génère-en une avec: openssl rand -hex 32
SESSION_SECRET=
